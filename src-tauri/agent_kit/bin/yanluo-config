#!/usr/bin/env python3
"""Yanluo whitelist config helper for agent CLIs. Edits sibling ../config.json."""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path

WHITELIST = {
    "asr_model_dir",
    "asr_model_id",
    "align_model_dir",
    "align_enabled",
    "vad_backend",
    "vad_aggression",
    "chunk_size_sec",
    "language",
    "translate_target_language",
    "llm_enabled",
    "llm_provider",
    "llm_model",
    "llm_api_base_url",
}

BOOL_KEYS = {"align_enabled", "llm_enabled"}
INT_KEYS = {"vad_aggression"}
FLOAT_KEYS = {"chunk_size_sec"}
REDACT = {"elevenlabs_api_key", "llm_api_key", "llm_credentials"}


def kit_dir() -> Path:
    return Path(__file__).resolve().parent.parent


def config_path() -> Path:
    env = os.environ.get("YANLUO_CONFIG")
    if env:
        return Path(env)
    return kit_dir().parent / "config.json"


def load() -> dict:
    path = config_path()
    if not path.is_file():
        print(f"error: config not found: {path}", file=sys.stderr)
        sys.exit(2)
    with path.open("r", encoding="utf-8") as f:
        return json.load(f)


def save(data: dict) -> None:
    path = config_path()
    tmp = path.with_suffix(".json.tmp")
    with tmp.open("w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
        f.write("\n")
    tmp.replace(path)


def coerce(key: str, raw: str):
    if key in BOOL_KEYS:
        v = raw.strip().lower()
        if v in ("1", "true", "yes", "on"):
            return True
        if v in ("0", "false", "no", "off"):
            return False
        raise ValueError(f"{key} expects bool, got {raw!r}")
    if key in INT_KEYS:
        return int(raw)
    if key in FLOAT_KEYS:
        return float(raw)
    return raw


def cmd_path() -> None:
    print(config_path())


def cmd_get(key: str | None) -> None:
    data = load()
    if key is None:
        out = {}
        for k, v in data.items():
            out[k] = "(redacted)" if k in REDACT else v
        print(json.dumps(out, ensure_ascii=False, indent=2))
        return
    if key in REDACT:
        print("error: secret key", file=sys.stderr)
        sys.exit(1)
    if key not in data:
        print(f"error: unknown key {key}", file=sys.stderr)
        sys.exit(1)
    val = data[key]
    if isinstance(val, (dict, list)):
        print(json.dumps(val, ensure_ascii=False))
    else:
        print(val)


def cmd_set(key: str, value: str) -> None:
    if key in REDACT or key not in WHITELIST:
        print(
            f"error: key not in whitelist: {key}\n"
            f"allowed: {', '.join(sorted(WHITELIST))}",
            file=sys.stderr,
        )
        sys.exit(1)
    data = load()
    try:
        data[key] = coerce(key, value)
    except ValueError as e:
        print(f"error: {e}", file=sys.stderr)
        sys.exit(1)
    if key == "vad_aggression":
        ag = data[key]
        if not isinstance(ag, int) or ag < 0 or ag > 3:
            print("error: vad_aggression must be 0..3", file=sys.stderr)
            sys.exit(1)
    save(data)
    print(f"ok: {key} = {data[key]!r}")


def main(argv: list[str]) -> None:
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        print(
            "usage:\n"
            "  yanluo-config path\n"
            "  yanluo-config get [key]\n"
            "  yanluo-config set <key> <value>",
            file=sys.stderr,
        )
        sys.exit(0 if len(argv) > 1 else 1)
    cmd = argv[1]
    if cmd == "path":
        cmd_path()
    elif cmd == "get":
        cmd_get(argv[2] if len(argv) > 2 else None)
    elif cmd == "set":
        if len(argv) < 4:
            print("usage: yanluo-config set <key> <value>", file=sys.stderr)
            sys.exit(1)
        cmd_set(argv[2], argv[3])
    else:
        print(f"error: unknown command {cmd}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main(sys.argv)
