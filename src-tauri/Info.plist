<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Bundle id / binary stay ASCII (Yanluo); Dock & About show 言落. -->
	<key>CFBundleDisplayName</key>
	<string>言落</string>
	<key>CFBundleName</key>
	<string>言落</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>言落需要麦克风权限以采集语音并进行转写。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>言落使用 Apple 语音识别将你的说话内容转换为文字。</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>言落需要通过 Apple Events 将转写结果粘贴到当前应用。</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>言落在「只录系统 / 两者都录」模式下需要屏幕录制权限，以采集系统正在播放的声音（扬声器或耳机，不会保存画面）。</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>言落需要采集系统正在播放的声音（含耳机输出），以便在戴耳机时转写/翻译播放内容。</string>
</dict>
</plist>
